# Bootstrap configuration. Everything else is stored in the database and edited
# from the web UI at http://<host>:<API_PORT>/
POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/fav

# Protects every /api/v2 endpoint, including the settings API. Required: an empty
# token would leave a freshly provisioned instance world-writable.
API_TOKEN=replace-with-a-strong-random-token

# Optional.
API_BIND=0.0.0.0
API_PORT=8091

# DEBUG makes a run explain itself: every intercepted request, and the shape of the
# payloads a source parses -- key names and types, never the values.
# LOG_LEVEL=INFO

# Optional. httpx, yt-dlp and gallery-dl all honour these, which is why there is no proxy
# setting in the UI.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
